# Copia este archivo como .env y rellena con tus credenciales
# El archivo .env NO se sube a Git

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx

# Resend (modo system en la API). Sin dominio propio verificado, Resend solo entrega bien al email de tu cuenta;
# con el remitente por defecto (onboarding@resend.dev) los demás destinos suelen no recibir el correo.
# 1) Panel Resend → Domains → añade tu dominio y los registros DNS (SPF/DKIM).
# 2) APP_EMAIL_SYSTEM_FROM=Noemi <noreply@TU_DOMINIO_VERIFICADO.com>
RESEND_API_KEY=
# APP_EMAIL_SYSTEM_FROM=Noemi <noreply@tudominio.com>

# OAuth correo Gmail / Microsoft (ver docs/EMAIL-OAUTH-SETUP.md)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8081/auth/email/oauth/google/callback
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8081/auth/email/oauth/microsoft/callback

# --- Producción (Vercel, perfil prod,serverless): variables de seguridad ---
# Todas se definen en el panel de Vercel (Project Settings -> Environment Variables), nunca en el repositorio.
# JWT_SECRET=                      # >= 32 caracteres aleatorios. Sin valor la API no arranca en prod.
# APP_EMAIL_TOKEN_SECRET=          # >= 32 caracteres. Cifra TOTP/SMTP/OAuth en BD (AES-256-GCM, clave derivada con HKDF).
# APP_EMAIL_TOKEN_SECRET_PREVIOUS= # Solo durante una rotación: la clave anterior (se sigue pudiendo descifrar con ella).
# STRIPE_WEBHOOK_SECRET=whsec_xxx  # OBLIGATORIO: sin él el webhook rechaza todos los eventos (fail-closed).
# RESEND_WEBHOOK_SECRET=whsec_xxx  # OBLIGATORIO si usas el webhook de Resend (firma Svix).
# SUPPORT_INBOX_EMAIL=             # Bandeja que recibe los tickets de soporte. Sin valor, el soporte no envía correo.
# CORS_ALLOWED_ORIGINS=            # Orígenes del front (o CORS_ALLOWED_ORIGIN_PATTERNS). Nunca "*".
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/DB?sslmode=require   # TLS obligatorio hacia la BD (SEC-40).
# APP_SECURITY_CLIENT_IP_MODE=vercel   # (perfil serverless ya lo fija) IP real del cliente para rate limit/auditoría.
# AUDIT_ANONYMIZE_IP=true              # Anonimiza la IP en la auditoría de accesos (RGPD).
# APP_SESSIONS_ANONYMIZE_IP=true       # Anonimiza la IP guardada en la lista de sesiones (SEC-31).
# APP_DEV_LOG_EMAIL_LINKS=false        # SOLO desarrollo local: escribe en el log los enlaces de verificación/recuperación.
# NOTA: con el perfil serverless Flyway está desactivado; aplica V47 y V48 (db/migration) manualmente en Neon
#       antes de desplegar esta versión.